{
  // Static-assets Worker: no server code, just ./public served from the edge.
  // https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-06",

  "assets": {
    "directory": "./public",
    // Serve /404.html for anything that does not exist.
    "not_found_handling": "404-page",
    // /about and /about/ resolve to the same page.
    "html_handling": "auto-trailing-slash"
  },

  // Wrangler creates the DNS records for these on deploy.
  "routes": [
    { "pattern": "ahmadandhikaharirie.my.id", "custom_domain": true },
    { "pattern": "www.ahmadandhikaharirie.my.id", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
